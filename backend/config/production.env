# Configuração para Produção AWS
# Copie este arquivo para .env e ajuste os valores

# Database AWS RDS
DATABASE_URL=postgresql://username:password@your-rds-endpoint.amazonaws.com:5432/treino_db

# Security - MUDE ESTAS CHAVES!
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
DEBUG=False
ENVIRONMENT=production

# AWS Específico
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# CORS (adicione seu domínio)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600 