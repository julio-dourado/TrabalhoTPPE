# Training App - Environment Variables
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ======================
# DATABASE CONFIGURATION
# ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=training_db

# ======================
# API SECURITY
# ======================
# IMPORTANTE: Mude esta chave em produção!
SECRET_KEY=your-secret-key-here-change-in-production-must-be-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# APPLICATION ENVIRONMENT
# ======================
ENVIRONMENT=development
DEBUG=true

# ======================
# CORS CONFIGURATION
# ======================
# Para desenvolvimento
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Para produção (descomente e ajuste seus domínios)
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com","https://api.yourdomain.com"]

# ======================
# DATABASE URLS
# ======================
# Desenvolvimento
DATABASE_URL=postgresql://postgres:postgres123@db:5432/training_db

# Produção (descomente e ajuste)
# DATABASE_URL=postgresql://seu_usuario:sua_senha@db:5432/seu_banco_prod

# ======================
# EXEMPLO DE PRODUÇÃO
# ======================
# Exemplo de configuração para produção:
#
# POSTGRES_USER=trainapp_user
# POSTGRES_PASSWORD=SuaSenhaSegura123!@#
# POSTGRES_DB=trainapp_prod
# SECRET_KEY=sua-chave-secreta-de-pelo-menos-32-caracteres-aqui-muito-segura
# ENVIRONMENT=production
# DEBUG=false
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
# DATABASE_URL=postgresql://trainapp_user:SuaSenhaSegura123!@#@db:5432/trainapp_prod 